# Copy to .env and fill in real values. Never commit .env.
APP_ENV=local
LOG_LEVEL=INFO
API_BASE_PATH=/api
API_CORS_ORIGINS=["*"]

# PostgreSQL (dev values; real ones come from secrets management)
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=agreements
# Host-side URL (tests/debugging). Containers override it internally.
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/agreements

REDIS_URL=redis://localhost:6379/0

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_BUCKET=audio
AUDIO_RETENTION_DAYS=30

JWT_SECRET=change-me-in-production
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=2592000

OTP_TTL_SEC=300
# Fixed OTP accepted only in local/dev (never set it in production).
DEV_OTP=1234

CONFIDENCE_THRESHOLD=0.8
CONSENT_MODE=notice
VOICE_PROVIDER=mock
VOICE_WEBHOOK_SECRET=dev-voice-secret

# МТС Exolve voice provider (plan.md §11.1). Leave the key empty to keep mock.
EXOLVE_API_BASE_URL=https://api.exolve.ru
EXOLVE_API_KEY=
EXOLVE_SIP_RESOURCE_ID=0
EXOLVE_CONSENT_NOTICE_FILE_ID=
# Exolve exposes no server-side media stream: the mobile client uploads the
# SDK's mixed call audio to this ingest URL for the ML pipeline.
MEDIA_INGEST_URL=ws://localhost:8000/api/ws/media

# Outbound integrations (in-app artifacts by default; real adapters are add-ons).
CALENDAR_PROVIDER=ics
REMINDERS_PROVIDER=local
MESSAGING_PROVIDER=draft

# --- ML pipeline (optional) ---
# T-one streaming ASR server (WebSocket). `docker compose --profile ml up -d asr`
# serves it on http://localhost:8080; on the research Mac it is shared via Tailscale.
ASR_WS_URL=ws://localhost:8080/api/ws
# Read-only Hugging Face token for gated pyannote diarization models.
HF_TOKEN=hf_<read-only token>
# Data directory for the STT CLI (data/audio, data/transcripts).
DATA_DIR=data

# --- LLM extraction (optional) ---
# OpenAI-совместимый API для извлечения договорённостей из транскрипта.
# Локально: LLM_API_KEY=ollama, LLM_BASE_URL=http://localhost:11434/v1, LLM_MODEL=qwen2.5:7b
LLM_API_KEY=<api key or "ollama">
LLM_BASE_URL=<base url, e.g. https://api.openai.com/v1 or http://localhost:11434/v1>
LLM_MODEL=<model name>