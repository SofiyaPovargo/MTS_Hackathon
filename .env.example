# Copy to .env and fill in real values. Never commit .env.
APP_ENV=local
LOG_LEVEL=INFO
API_BASE_PATH=/api
API_CORS_ORIGINS=["*"]

# PostgreSQL (dev values; real ones come from secrets management)
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=agreements
# Host-side URL (tests/debugging). Containers override it internally.
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/agreements

REDIS_URL=redis://localhost:6379/0

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_BUCKET=audio
AUDIO_RETENTION_DAYS=30
# Cap for a single client audio upload (mobile app -> POST /calls/{id}/audio).
MAX_AUDIO_UPLOAD_MB=64

JWT_SECRET=change-me-in-production
# Encrypts transcripts and raw LLM output at rest (plan §16). Set it once and
# keep it secret: data written with one key cannot be read with another. A Fernet
# key or any passphrase works.
DATA_ENCRYPTION_KEY=change-me-in-production
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=2592000

OTP_TTL_SEC=300
# Fixed OTP accepted only in local/dev (never set it in production).
DEV_OTP=1234

CONFIDENCE_THRESHOLD=0.8
CONSENT_MODE=notice
VOICE_PROVIDER=mock
VOICE_WEBHOOK_SECRET=dev-voice-secret

# МТС Exolve voice provider (plan.md §11.1). Leave the key empty to keep mock.
EXOLVE_API_BASE_URL=https://api.exolve.ru
EXOLVE_API_KEY=
EXOLVE_SIP_RESOURCE_ID=0
EXOLVE_CONSENT_NOTICE_FILE_ID=
# Inbound routing (call-control webhook): which app user receives a call that
# arrived on a SIP resource, and the SIP URI their app leg registers on.
# Entries ``sip_id=phone:sip_uri`` separated by commas (one per user).
EXOLVE_SIP_ROUTES=
# Public base URL Exolve calls back to (call-control + event URL). Must be
# reachable by Exolve, so it is configuration, not derived from the request.
PUBLIC_BASE_URL=http://localhost:8000
# Exolve exposes no server-side media stream: the mobile client uploads the
# SDK's call audio to ``POST {MEDIA_INGEST_URL}/calls/{call_id}/audio``.
MEDIA_INGEST_URL=http://localhost:8000/api

# Outbound integrations (in-app artifacts by default; real adapters are add-ons).
CALENDAR_PROVIDER=ics
REMINDERS_PROVIDER=local
MESSAGING_PROVIDER=draft

# --- ML pipeline (optional) ---
# T-one streaming ASR server (WebSocket). `docker compose --profile ml up -d asr`
# serves it on http://localhost:8080; on the research Mac it is shared via Tailscale.
ASR_WS_URL=ws://localhost:8080/api/ws
# Read-only Hugging Face token for gated pyannote diarization models.
HF_TOKEN=hf_<read-only token>
# Data directory for the STT CLI (data/audio, data/transcripts).
DATA_DIR=data
# VAD (plan.md §12): trim dead air at the edges of a leg before ASR. Internal
# silence is kept so streaming ASR can still split phrases.
VAD_ENABLED=false
VAD_PAD_SEC=0.2
VAD_MIN_SPEECH_MS=100
VAD_MIN_SILENCE_MS=100

# Live streaming ASR (plan.md §12): the client streams per-leg PCM over WS
# (?leg=) to /ws/calls/{id}/audio; the API relays to Redis; worker-asr-live runs
# T-one incrementally and worker-ai-live updates agreements (debounced).
# Inside compose ASR_WS_URL is ws://asr:8080/api/ws (service name, not localhost).
LIVE_ASR_ENABLED=true
LIVE_DEBOUNCE_SEC=20
LIVE_MAX_SEC=3600

# --- LLM extraction (optional) ---
# OpenAI-совместимый API для извлечения договорённостей из транскрипта.
# В docker compose Ollama поднимается сервисом `ollama`; воркеры ходят по имени
# сервиса (не localhost). Самохостинг: qwen2.5:7b.
# Локально на хосте: LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=qwen2.5:7b